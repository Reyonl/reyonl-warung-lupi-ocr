{
  "engine": {
    "preferred_engine": "auto",
    "tesseract_cmd": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
    "tesseract_lang": "ind",
    "tessdata_dir": "tessdata",
    "easyocr_languages": ["en", "id"],
    "gemini_model": "gemini-3.5-flash",
    "claude_model": "claude-3-5-sonnet-20241022",
    "cloud_fallback_threshold": 0.45
  },
  "api": {
    "base_url": "http://localhost:8000",
    "timeout": 30
  },
  "interpreter": {
    "region_confidence_threshold": 0.35,
    "product_match_threshold": 0.85,
    "customer_match_threshold": 0.80,
    "low_confidence_threshold": 0.50,
    "date_confidence_threshold": 0.60,
    "line_y_tolerance": 60,
    "auto_fill_defaults": true
  },
  "audit": {
    "enabled": true,
    "log_dir": "audit_logs",
    "retention_days": 30,
    "detailed": true
  }
}
